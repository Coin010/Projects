# Integer division via repeated subtraction
# Input:  r1 = numerator, r2 = denominator
# Output: r3 = quotient (printed)
# Note: handles denominator = 0 by printing 0

# 0: GET r1 (integer dividend)
1010001011111111
# 1: GET r2 (integer divisor)
1010010011111111
# 2: AND r3, r3, #0    ; quotient = 0 CLEAR r3
0010011011100000
# 3: ADD r2, r2, #0    ; set NZP from denominator
0001010010100000
# 4: BRz 12            ; if denominator == 0, go print 0
1100010000001100

# 5: NOT r4, r2        ; r4 = ~divisor
0011100010111111
# 6: ADD r4, r4, #1    ; r4 = -divisor
0001100100100001

# loop:
# 7: ADD r5, r1, r4    ; trial = dividend - divisor
0001101001000100
# 8: BRn 12            ; if trial < 0, done
1100100000001100
# 9: ADD r1, r5, #0    ; dividend = trial
0001001101100000
# 10: ADD r3, r3, #1   ; quotient++
0001011011100001
# 11: JMP 7            ; repeat
1101000000000111

# done:
# 12: PUT r3 (integer quotient)