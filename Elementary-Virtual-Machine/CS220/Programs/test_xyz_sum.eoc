# Reads X and Y, stores them in memory, computes Z = X + Y, then prints Z
# Memory layout:
# 11: X
# 12: Y
# 13: Z

# 0: GET r1 (integer)
1010001011111111
# 1: ST r1, X (addr 11)
0111001000001011

# 2: GET r2 (integer)
1010010011111111
# 3: ST r2, Y (addr 12)
0111010000001100

# 4: LD r3, X
0100011000001011
# 5: LD r4, Y
0100100000001100

# 6: ADD r5, r3, r4
0001101011000100
# 7: ST r5, Z (addr 13)
0111101000001101

# 8: LD r6, Z
0100110000001101
# 9: PUT r6 (integer)
1011110011111111

# 10: HALT
0000000000000000

# Data section (allocated after HALT)
# 11: X
0000000000000000
# 12: Y
0000000000000000
# 13: Z
0000000000000000
