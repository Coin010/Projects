# Read n characters from user and store them as a NULL-terminated string in memory
# Behavior:
# 1) Print prompt "N="
# 2) GET integer n
# 3) Read n characters with GETC, store sequentially
# 4) Write NULL terminator after the last character
#
# Register usage:
# r1 = remaining count n
# r2 = pointer to current destination address
# r4 = current character / zero for terminator
#
# Address map:
# 0  LD   r0, prompt 'N'
# 1  PUTC r0
# 2  LD   r0, prompt '='
# 3  PUTC r0
# 4  GET  r1 (integer n)
# 5  LD   r2, string_start_ptr
# 6  BRz  done           ; if n == 0, store just NULL and halt
# 7  GETC r4
# 8  STR  r4, r2, #0
# 9  ADD  r2, r2, #1
# 10 ADD  r1, r1, #-1
# 11 BRp  loop (addr 7)  ; keep reading while n > 0
# 12 AND  r4, r4, #0     ; r4 = 0
# 13 STR  r4, r2, #0     ; write NULL terminator
# 14 HALT
# 15 data: 'N'
# 16 data: '='
# 17 data: pointer to first char slot (addr 19)
# 18 data: unused/padding
# 19+ string storage

0100000000001111
1011000111111111
0100000000010000
1011000111111111
1010001011111111
0100010000010001
1100010000001100
1010100111111111
1001100010000000
0001010010100001
0001001001111111
1100001000000111
0010100100100000
1001100010000000
0000000000000000
0000000001001110
0000000000111101
0000000000010011
