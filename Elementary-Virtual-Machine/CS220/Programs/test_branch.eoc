# Test program for BR (Branch) instruction
# This program tests conditional branching based on condition codes
# LOAD to location 1 in memory

# Test 1: Set up positive condition (P=1)
# ADD r0, r0, #1 - Add 1 to r0 (should set P=1)
0001000000100001

# Branch if positive (should take branch)
# BR p offset - Branch to offset 6 if P flag is set
1100001000000110

# This instruction should be skipped due to branch
0000000000000000

# This instruction should be skipped due to branch  
0000000000000000

# This instruction should be skipped due to branch
0000000000000000

# Target of first branch (offset 6)
# ADD r1, r1, #0 - This sets Z=1 (zero result)
0001001001100000

# Branch if zero (should take branch) 
# BR z offset - Branch to offset 10 if Z flag is set
1100010000001010

# This should be skipped
0000000000000000

# This should be skipped
0000000000000000

# Target of second branch (offset 10)
# Load a negative number: ADD r2, r2, #-1
0001010010111111

# Branch if negative (should take branch)
# BR n offset - Branch to offset 14 if N flag is set  
1100100000001110

# This should be skipped
0000000000000000

# This should be skipped
0000000000000000

# Target of third branch (offset 14)
# Test unconditional branch: BR nzp (always branch)
1100111000010000

