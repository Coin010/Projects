# Test program for equality comparison of registers R1 and R2
# Tests multiple scenarios including when one register is 0
#
# Method: Since there's no SUB instruction, we use ADD with the bitwise NOT + 1
# to perform R1 - R2, then check if the result is zero (Z flag set)
#
# Test cases:
# Case 1: R1 = 5, R2 = 5 (equal values) 
# Case 2: R1 = 0, R2 = 0 (both zero)
# Case 3: R1 = 7, R2 = 0 (one is zero)
# Case 4: R1 = 0, R2 = 3 (other is zero)
# Case 5: R1 = 10, R2 = 15 (unequal values)

# === CASE 1: Test R1=5, R2=5 (should be equal) ===
# Load test values into R1 and R2
# LD R1, [data1] ; R1 <- 5
# LD R2, [data2] ; R2 <- 5
0100001000011001   
0100010000011010    

# Compare R1 and R2 by computing R1 - R2
# use: R1 + (~R2 + 1) = R1 - R2
# NOT R3, R2     ; R3 <- ~R2
# ADD R3, R3, #1 ; R3 <- ~R2 + 1 = -R2
# ADD R4, R1, R3 ; R4 <- R1 + (-R2) = R1 - R2
0011011010111111    
0001011011100001    
0001100001000011    

# Branch if equal (Z flag set)
# BR z, equal1   ; if Z=1, branch to equal1 label
1100010000000111 

# Not equal case - load 0 into R5
 # BR, next1      ; unconditional branch to next test (8)
1100101000001000

# Equal case - load 1 into R5 (equal1 label)
# ADD R5, R5, #1 ; R5 <- 1 (indicates equal) mem(7)
0001101101100001    

# === CASE 2: Test R1=0, R2=0 (both zero, should be equal) ===
# next1 label:
# LD R1, [data3] ; R1 <- 0
# LD R2, [data4] ; R2 <- 0
0100001000011011    
0100010000011100    

# Compare R1 and R2
# NOT R3, R2     ; R3 <- ~R2
# ADD R3, R3, #1 ; R3 <- -R2
# ADD R4, R1, R3 ; R4 <- R1 - R2
0011011010111111    
0001011011100001    
0001100001000011    

# Branch if equal (13)
# BR z, equal2   ; if Z=1, branch to equal2 (mem[15])
1100010000001111    

# Not equal (14)
# BR, next2      ; branch to next test goto(16)
1100101000010000    

# Equal case (equal2 label) (15)
# ADD R6, R6, #1 ; R6 <- 1 (equal)
0001110110100001    

# === CASE 3: Test R1=7, R2=0 (one is zero, should not be equal) ===
# next2 label:
# LD R1, [data5] ; R1 <- 7
# LD R2, [data6] ; R2 <- 0
0100001000011101   
0100010000011110   

# Compare R1 and R2
# NOT R3, R2
# ADD R3, R3, 1
# ADD R4, R1, R3
0011011010111111
0001011011100001
0001100001000011

# Branch if equal (21)
# BR z, equal3 (mem[23])
1100010000010111    

# Not equal (positive or negative)
# BR, next3
1100101000011000    

# Equal case (equal3 label) (23)
# ADD R7, R7, #1 ; R7 <- 1 (equal)
0001111111100001    

# next3 label - End of tests
# HALT
0000000000000000    

# === DATA SECTION ===
# Address 25 (11001): data1 (5)
0000000000000101    
# Address 26 (11010): data2  (5)
0000000000000101    
# Address 27 (11011): data3 (0)
0000000000000000    
# Address 28 (11100): data4 (0)
0000000000000000    
# Address 29 (11101): data5 (7)
0000000000000111    
# Address 30 (11110): data6 (0)
0000000000000000    


# First two equalities should be true settings r5,6 = 1 (True)
# Last equality should be false, leaving the last regrister r7 = 0